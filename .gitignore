# Phase 6 (regenerable web/bake products and fetched tools)
tools/bin/
tools/lib/
tools/dl/
export/out/
export/inventory.json
web/node_modules/
web/dist/
web/public/assets/
renders/web/**/tiles/
*.glb
*.ktx2
*.hdr
renders/web/gate1_pair_cam0*.png
# every gate's pair sheets: 3.5 MB each, regenerable from the committed station PNGs with
# web/tools/gate1_sheets.py --viewer-glob 'renders/web/<tag>_cam%02d.png' --prefix <tag>
renders/web/gate2_pair_cam0*.png
renders/web/gate*_pair_cam0*.png
renders/web/round*_pair_cam0*.png

# Gate 4 (review carry): full-resolution viewer frames are REGENERABLE and must not be committed.
# Only 960 px copies under renders/web/960/ go in the tree (the CLAUDE.md image rule); the full-res
# frames live beside them and here, and the gate tiles were already ignored above.
renders/web/full/
renders/web/*_cam0*.png
renders/web/*_perf1440*.png
# the bare-URL capture (C4): the full-res PNG is regenerable, the 960 px copy under 960/ is committed
renders/web/*_bareurl.png
renders/web/*_walkin*.png
# 6c round-2 A/B and diagnostic captures: regenerable from the flags named in web/README.md, and the
# ones any number cites are kept as 960 px copies under renders/web/960/ (round-2 review 2)
renders/web/r16b_*.png
renders/web/smoke_*.png
renders/web/smoke16b_*.png
renders/web/round16bm60_*.png
renders/web/placecheck*.png
renders/web/verify*.png
!renders/web/960/*
renders/web/round13b_*.png
renders/web/round13direct_*.png

# Phase 6b: the development STUB tier manifest (web/tools/stub_tiers.mjs regenerates it)
web/public/stub/

# Phase 6b: the assembled Cloudflare Pages publish directory (web/deploy.sh rebuilds it)
web/deploy_out/

# Phase 6b: generated by web/deploy.sh (the publish directory is rebuilt on every deploy)
web/wrangler.jsonc

# Phase 6b: full-resolution viewer captures stay out of the tree; the 960 px jpgs under
# renders/web/960/ are what is committed (CLAUDE.md image rule)
renders/web/6b_*.png
renders/web/6bbase*.png
renders/web/6btier*.png
renders/web/gate5*_cam0*.png
renders/web/gate5.png
renders/web/gate5b_cam06.png
renders/web/gate5_perf1440*.png

# Phase 7: full-resolution viewer captures and the orbit frames stay out of the tree; the 960 px
# composites under renders/web/960/ are what is committed (CLAUDE.md image rule).  The perf JSONs are
# small and ARE committed - they are the evidence for the item C A/B.
renders/web/p7*.png
# the per-capture sidecars are ~210 kB each and fully regenerable; the perf JSONs are the evidence
renders/web/p7*_shot.json
renders/web/p7*_cam.json
renders/web/p7net_6c.json
renders/web/p7net_p7.json
!renders/web/960/*

# Phase 8: a capture's camera sidecar carries no measurement (the perf jsons do), and one is 200 kB.
renders/web/*_cam.json

# Phase 8b fix round (item a's A/B frames, item c's flag sweep): the perf JSONs and the 960 px
# composite under renders/web/960/ are committed, the full-resolution frames are regenerable.
renders/web/p8b_*.png
!renders/web/960/*

# Phase 8a — the ?cardsun= captures and the sweep; the 960 px composites under renders/web/ are
# what is committed (CLAUDE.md image rule), the full-resolution frames are regenerable.
renders/web/p8a_*.png

# Phase 8 comparison sheet (scripts/phase8_sheet.py): full-resolution 100% tile crops are
# regenerable from the source renders + boxes.json; only the 960 px composites are committed.
renders/qa_comparisons/phase8_tiles/
renders/qa_comparisons/phase9_tiles/
# Phase 8 Cycles station references: the 1080p PNGs are 8-9 MB each and regenerable from
# scripts/p8_cycles_refs.py; the 960 px copies and the composite beside them are committed.
renders/qa_comparisons/cycles_p8/*.png
renders/qa_comparisons/cycles_p9/*.png
docs/usage/turns_all.json
